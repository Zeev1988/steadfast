# Model selection — any LiteLLM-supported model string.
# Examples: claude-sonnet-4-20250514, gpt-4o, gemini/gemini-2.0-flash, mistral/mistral-large-latest
LLM_MODEL=claude-sonnet-4-20250514

# LLM provider API keys — set the one matching your model choice.
# LiteLLM reads the correct key automatically based on the model string.
ANTHROPIC_API_KEY=your-api-key-here
OPENAI_API_KEY=your-api-key-here
# GEMINI_API_KEY=your-api-key-here   # Google AI Studio; use with LLM_MODEL=gemini/...
# MISTRAL_API_KEY=your-api-key-here

# Max output tokens — lower for small models, raise if you see finish_reason=length truncation
# LLM_MAX_TOKENS=2048

# Optional: custom proxy / base URL
# ANTHROPIC_BASE_URL=https://your-proxy-url-here
# LLM_BASE_URL=https://your-proxy-url-here
